  "components": {
    "schemas": {
      "CancelRequest": {
        "properties": {
          "request_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "title": "Request Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "request_id"
        ],
        "title": "CancelRequest"
      },
      "CancelResult": {
        "properties": {
          "api_version": {
            "type": "string",
            "const": "1.0",
            "title": "Api Version",
            "default": "1.0"
          },
          "request_id": {
            "type": "string",
            "title": "Request Id"
          },
          "status": {
            "type": "string",
            "const": "cancelling",
            "title": "Status",
            "default": "cancelling"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "request_id"
        ],
        "title": "CancelResult"
      },
      "ChatRequest": {
        "properties": {
          "messages": {
            "items": {
              "$ref": "#/components/schemas/Message"
            },
            "type": "array",
            "maxItems": 20,
            "minItems": 1,
            "title": "Messages"
          },
          "options": {
            "$ref": "#/components/schemas/Options"
          },
          "model_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model Id"
          },
          "conversation_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Conversation Id"
          },
          "mode": {
            "type": "string",
            "enum": [
              "model",
              "offline"
            ],
            "title": "Mode",
            "default": "model"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "messages"
        ],
        "title": "ChatRequest"
      },
      "ChatResult": {
        "properties": {
          "api_version": {
            "type": "string",
            "const": "1.0",
            "title": "Api Version",
            "default": "1.0"
          },
          "request_id": {
            "type": "string",
            "title": "Request Id"
          },
          "conversation_id": {
            "type": "string",
            "title": "Conversation Id"
          },
          "model_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model Id"
          },
          "provider_id": {
            "type": "string",
            "enum": [
              "ollama",
              "offline"
            ],
            "title": "Provider Id"
          },
          "status": {
            "type": "string",
            "enum": [
              "completed",
              "truncated",
              "cancelled"
            ],
            "title": "Status"
          },
          "reply": {
            "type": "string",
            "title": "Reply"
          },
          "finish_reason": {
            "type": "string",
            "enum": [
              "stop",
              "length",
              "cancelled"
            ],
            "title": "Finish Reason"
          },
          "context_messages": {
            "type": "integer",
            "title": "Context Messages"
          },
          "context_trimmed": {
            "type": "boolean",
            "title": "Context Trimmed"
          },
          "metrics": {
            "$ref": "#/components/schemas/Metrics"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "request_id",
          "conversation_id",
          "model_id",
          "provider_id",
          "status",
          "reply",
          "finish_reason",
          "context_messages",
          "context_trimmed",
          "metrics"
        ],
        "title": "ChatResult"
      },
      "ErrorDetail": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "request_id": {
            "type": "string",
            "title": "Request Id"
          },
          "retryable": {
            "type": "boolean",
            "title": "Retryable"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "code",
          "request_id",
          "retryable"
        ],
        "title": "ErrorDetail"
      },
      "ErrorResult": {
        "properties": {
          "api_version": {
            "type": "string",
            "const": "1.0",
            "title": "Api Version",
            "default": "1.0"
          },
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorResult"
      },
      "Health": {
        "properties": {
          "api_version": {
            "type": "string",
            "const": "1.0",
            "title": "Api Version",
            "default": "1.0"
          },
          "live": {
            "type": "boolean",
            "title": "Live"
          },
          "ready": {
            "type": "boolean",
            "title": "Ready"
          },
          "instance_id": {
            "type": "string",
            "title": "Instance Id"
          },
          "profile": {
            "type": "string",
            "const": "local",
            "title": "Profile",
            "default": "local"
          },
          "provider_status": {
            "type": "string",
            "title": "Provider Status"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "live",
          "ready",
          "instance_id",
          "provider_status"
        ],
        "title": "Health"
      },
      "Message": {
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "user",
              "assistant"
            ],
            "title": "Role"
          },
          "content": {
            "type": "string",
            "maxLength": 12000,
            "minLength": 1,
            "title": "Content"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "title": "Message"
      },
      "Metrics": {
        "properties": {
          "elapsed_ms": {
            "type": "number",
            "title": "Elapsed Ms"
          },
          "first_token_ms": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "First Token Ms"
          },
          "output_tokens": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Output Tokens"
          },
